# NodeX local development. Keep real credentials in your uncommitted .env file.
NODEX_BIND_ADDR=127.0.0.1:8080
NODEX_DATABASE_URL=sqlite://nodex.db
NODEX_MODE=paper

# Create a Helius API key at https://www.helius.dev/
# The backend derives Mainnet HTTP and WebSocket URLs from this key.
HELIUS_API_KEY=
HELIUS_API_KEY2=
HELIUS_API_KEY3=
HELIUS_API_KEY4=
HELIUS_API_KEY5=
HELIUS_API_KEY6=
HELIUS_API_KEY7=
HELIUS_API_KEY8=
HELIUS_API_KEY9=
HELIUS_API_KEY10=
HELIUS_API_KEY11=
HELIUS_API_KEY12=
HELIUS_API_KEY13=
HELIUS_API_KEY14=
HELIUS_API_KEY15=
HELIUS_API_KEY16=
HELIUS_API_KEY17=
HELIUS_API_KEY18=
HELIUS_API_KEY19=
HELIUS_API_KEY20=

# Maximum simultaneous outbound Solana HTTP RPC requests (1-100; default 20).
HELIUS_MAX_CONCURRENT_REQUESTS=20

# Optional RugCheck API key for authenticated/plan-specific report access.
# The public token summary endpoint can be attempted without this key.
RUGCHECK_API_KEY=

# Optional explicit endpoints override the Helius-derived endpoints.
SOLANA_RPC_HTTP_URL=
SOLANA_RPC_WS_URL=

# Profile identity and read-only on-chain wallet sync.
# Provide a 64-byte Solana keypair as a JSON byte array or base58-encoded secret key.
# Keep this value in a secret manager in production; never commit a real key.
NODEX_WALLET_PRIVATE_KEY=
NODEX_PROFILE_NAME=NodeX

# Paper wallet: 1 SOL initial balance; 0.1 SOL default strategy trade size.
NODEX_PAPER_STARTING_BALANCE_LAMPORTS=1000000000
NODEX_PAPER_TRADE_AMOUNT_LAMPORTS=100000000

# Pump.fun program monitored by the first logsSubscribe integration.
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

# Live signing and transaction submission are not implemented or enabled.

# Operator API authentication uses NODEX_ADMIN_API_KEY. Set a long random secret in production.

# Operator API authentication. Set a long random secret in the production environment.
NODEX_ADMIN_API_KEY=

# System journal cleanup is disabled by default. Enable only after reviewing that
# cleanup affects archived system-wide journal data, not just NodeX service entries.
NODEX_ALLOW_SYSTEM_JOURNAL_CLEANUP=false
